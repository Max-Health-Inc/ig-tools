{
  "name": "@max-health-inc/ig-tools",
  "version": "0.6.0",
  "description": "Build tooling for the org's FHIR IG packages: resolve the BabelFHIR-TS release that passed parity, compile an IG into a typed package, and decide its release version.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Health-Inc/ig-tools.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "resolve-babelfhir": "./bin/resolve-babelfhir.js",
    "release-plan": "./bin/release-plan.js"
  },
  "files": [
    "src",
    "bin",
    "!src/*.test.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"src/*.test.js\""
  },
  "license": "MIT"
}
